<%- include('./partials/header') %>

<section class="bookings-admin">
    <h1>Bookings Admin</h1>
    <p>Review bookings and passenger details, 10 at a time. Newest bookings first; dates shown in UTC.</p>
    <form id="bookings-filters" class="booking-filters">
        <label>Ticket class
            <select name="ticketClass">
                <option value="">All ticket classes</option>
                <option value="standard">Standard</option>
                <option value="premium">Premium</option>
                <option value="first">First</option>
            </select>
        </label>
        <label>Booked from (UTC)
            <input type="date" name="startDate">
        </label>
        <label>Booked through (UTC)
            <input type="date" name="endDate">
        </label>
        <button type="submit">Apply filters</button>
        <button type="button" id="bookings-clear">Clear filters</button>
    </form>
    <p id="bookings-loading" role="status">Loading bookings...</p>
    <p id="bookings-error" role="alert" hidden></p>
    <p id="bookings-empty" hidden>No bookings yet.</p>
    <button type="button" id="bookings-retry" hidden>Retry</button>
    <p id="bookings-summary" role="status"></p>
    <nav class="bookings-pagination" aria-label="Booking pages">
        <button type="button" id="bookings-previous" disabled>Previous</button>
        <span id="bookings-page">No pages</span>
        <button type="button" id="bookings-next" disabled>Next</button>
    </nav>
    <div id="bookings-list" aria-live="polite"></div>

    <template id="booking-card-template">
        <article class="booking-admin-card">
            <h2><a data-field="reference"></a></h2>
            <dl>
                <div><dt>Trip</dt><dd data-field="trip"></dd></div>
                <div><dt>Schedule</dt><dd data-field="schedule"></dd></div>
                <div><dt>Ticket class</dt><dd data-field="ticket"></dd></div>
                <div><dt>Travel day</dt><dd data-field="day"></dd></div>
                <div><dt>Booked on</dt><dd data-field="created"></dd></div>
            </dl>
            <h3>Passengers</h3>
            <ul data-field="passengers"></ul>
        </article>
    </template>
    <noscript>Enable JavaScript to load bookings.</noscript>
</section>
<script src="/js/bookings.js" defer></script>

<%- include('./partials/footer') %>
