<%- include('../partials/header') %>

    <section class="content">
        <h1>Manage Train Trips</h1>

        <p>View, update, and delete existing train trips.</p>

        <div id="admin-trips-loading">Loading trips...</div>

        <div id="admin-trips-error" hidden></div>

        <div id="admin-trips-success" hidden></div>

        <div id="trip-form-container" hidden>
            <h2 id="trip-form-title">Edit Trip</h2>

            <form id="trip-form">
                <input type="hidden" id="trip-id">

                <label for="trip-name">Trip Name</label>
                <input type="text" id="trip-name" required>

                <label for="trip-description">Description</label>
                <textarea id="trip-description" required></textarea>

                <label for="trip-region">Region</label>
                <input type="text" id="trip-region" required>

                <label for="trip-start">Starting Station</label>
                <select id="trip-start" required>
                    <option value="">Select starting station</option>
                </select>

                <label for="trip-end">Ending Station</label>
                <select id="trip-end" required>
                    <option value="">Select ending station</option>
                </select>

                <label for="trip-schedule">Schedule</label>
                <select id="trip-schedule">
                    <option value="">Select a schedule</option>
                </select>

                <label for="trip-duration">Duration</label>
                <input type="text" id="trip-duration" required>

                <label for="trip-distance">Distance (km)</label>
                <input type="number" id="trip-distance" min="0" required>

                <label for="trip-season">Best Season</label>
                <input type="text" id="trip-season" required>

                <label for="trip-highlights">Highlights (one per line)</label>
                <textarea id="trip-highlights" required></textarea>

                <label for="trip-months">
                    Operating Months (1-12, comma separated)
                </label>
                <input type="text" id="trip-months" placeholder="Example: 3,4,5,6,7" required>

                <div>
                    <button type="submit" id="save-trip">Save Changes</button>

                    <button type="button" id="cancel-trip">
                        Cancel
                    </button>
                </div>
            </form>
        </div>

        <h2>Existing Trips</h2>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Trip Name</th>
                        <th>Region</th>
                        <th>Starting Station</th>
                        <th>Ending Station</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="admin-trips-list"></tbody>
            </table>
        </div>
    </section>

    <script src="/js/admin-trips.js" defer></script>

    <%- include('../partials/footer') %>